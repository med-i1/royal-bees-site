---
import '@fontsource/el-messiri/arabic-500.css';
import '@fontsource/el-messiri/arabic-700.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-600.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileMenu from '../components/MobileMenu.astro';
import OrderDrawer from '../components/OrderDrawer.astro';
import { SITE } from '../config';

interface Props { title: string; description: string; image?: string; noindex?: boolean; flush?: boolean }
const { title, description, image = '/og-default.jpg', noindex = false, flush = false } = Astro.props;
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#140B05" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_EG" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <script is:inline>(function(){var c=navigator.connection||{};var low=c.saveData||/(^|-)2g$/.test(c.effectiveType||"");if(!matchMedia("(prefers-reduced-motion: reduce)").matches&&!low)document.documentElement.classList.add("js","js-story");})();</script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">تخطَّ للمحتوى</a>
    <Header />
    <MobileMenu />
    <main id="main" class:list={[{ padded: !flush }]}><slot /></main>
    <Footer />
    <OrderDrawer />
    <script>
      import { initMotion } from "../scripts/motion";
      import "../scripts/header";
      import "../scripts/order-ui";
      document.addEventListener("astro:page-load", initMotion);
    </script>
  </body>
</html>

<style>
  .padded{padding-top:5.5rem}
  :global(.js [data-reveal]){opacity:0;transform:translateY(40px)}
  .skip{position:absolute;inset-inline-start:1rem;top:-100px;z-index:100;background:var(--gold);color:#2A1606;padding:.6rem 1rem;border-radius:8px}
  .skip:focus{top:1rem}
</style>
