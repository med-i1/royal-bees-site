---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('encyclopedia')).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} image={post.data.cover}>
  <article class="prose">
    <ol class="crumbs"><li><a href="/">الرئيسية</a></li><li><a href="/encyclopedia/">موسوعة العسل</a></li></ol>
    <h1>{post.data.title}</h1>
    <Content />
    <p class="cta"><a class="btn btn-primary" href="/honey/sidr/">تصفّح عسل السدر</a></p>
  </article>
</Base>
<style>
  .prose{max-width:46rem;margin:0 auto;padding:2.5rem var(--pad-x) 5rem}
  .prose h1{font-family:var(--font-display);font-size:clamp(2rem,4.5vw,3rem);line-height:1.3;margin:.6rem 0 1.5rem}
  .prose :global(h2){font-family:var(--font-display);font-size:1.6rem;margin:2.2rem 0 .8rem;color:var(--gold-2)}
  .prose :global(p),.prose :global(li){color:#E8DBC2;font-size:1.06rem;line-height:1.95}
  .prose :global(ul){padding-inline-start:1.3rem;display:grid;gap:.5rem}
  .prose :global(blockquote){margin:2rem 0;padding:1.1rem 1.3rem;border-inline-start:3px solid var(--gold);background:rgba(247,196,90,.06);border-radius:12px}
  .cta{margin-top:2.5rem}
</style>
