---
import Base from '../layouts/Base.astro';
---
<Base title="الصفحة مش موجودة" description="الصفحة اللي بتدور عليها مش موجودة." noindex>
  <section class="nf">
    <p class="eyebrow">٤٠٤</p>
    <h1>الصفحة دي <span class="accent">مش موجودة</span></h1>
    <p class="lead">يمكن الرابط اتغير. تقدر تكمل من هنا:</p>
    <div class="row"><a class="btn btn-primary" href="/honey/">تصفّح العسل</a><a class="btn btn-ghost" href="/">الرئيسية</a></div>
  </section>
</Base>
<style>
  .nf{min-height:70vh;display:grid;place-content:center;text-align:center;gap:1rem;padding:2rem var(--pad-x)}
  .nf .eyebrow{justify-content:center} h1{font-family:var(--font-display);font-size:clamp(2.2rem,6vw,4rem)} .lead{margin:0 auto}
  .row{display:flex;justify-content:center;gap:.9rem;flex-wrap:wrap;margin-top:1rem}
</style>
