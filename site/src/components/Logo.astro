---
// Royal Bees roundel. Vector source: src/assets/logo.svg (redrawn from assets/logo-source.png, client approval pending).
// Served as a pre-rendered raster: inline SVG text-on-path cost seconds of main-thread time on mid-range phones.
// Re-render after editing the SVG: node scripts/render-logo.mjs
interface Props { size?: number; withWordmark?: boolean; class?: string }
const { size = 40, withWordmark = false, class: cls = '' } = Astro.props;
---
<span class:list={['logo', cls]}>
  <img src="/images/logo-160.webp" srcset="/images/logo-160.webp 160w, /images/logo-384.webp 384w" sizes={`${size}px`} width={size} height={size} alt={withWordmark ? '' : 'شعار مملكة النحل'} decoding="async" />
  {withWordmark && <span class="logo-word">مملكة النحل</span>}
</span>

<style>
  .logo{display:inline-flex;align-items:center;gap:.6rem}
  .logo img{flex:none;border-radius:50%}
  .logo-word{font-family:var(--font-display);font-weight:700;font-size:1.35rem;line-height:1}
</style>
