---
// Royal Bees roundel, redrawn as vector from assets/logo-source.png (client approval pending).
interface Props { size?: number; withWordmark?: boolean; class?: string }
const { size = 40, withWordmark = false, class: cls = '' } = Astro.props;
const uid = 'lg' + Math.random().toString(36).slice(2, 8);
---
<span class:list={['logo', cls]}>
  <svg width={size} height={size} viewBox="0 0 220 220" role="img" aria-label="شعار مملكة النحل">
    <defs>
      <path id={`${uid}-l`} d="M 44 118 A 68 68 0 0 1 100 44" />
      <path id={`${uid}-r`} d="M 120 44 A 68 68 0 0 1 176 118" />
      <linearGradient id={`${uid}-g`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F3D27A"/><stop offset="1" stop-color="#B8862B"/></linearGradient>
    </defs>
    <circle cx="110" cy="110" r="106" fill="#111"/>
    <circle cx="110" cy="110" r="98" fill="none" stroke="#C9A13B" stroke-width="1.4" opacity=".7"/>
    <!-- crown -->
    <path d="M90 58 L94 40 L102 50 L110 34 L118 50 L126 40 L130 58 Z" fill={`url(#${uid}-g)`}/>
    <rect x="89" y="58" width="42" height="6" rx="2" fill={`url(#${uid}-g)`}/>
    <circle cx="94" cy="39" r="2.6" fill="#F3D27A"/><circle cx="110" cy="33" r="2.8" fill="#F3D27A"/><circle cx="126" cy="39" r="2.6" fill="#F3D27A"/>
    <!-- bee -->
    <g fill="none" stroke="#fff" stroke-width="2.4" stroke-linejoin="round">
      <path d="M106 96 C82 70 52 78 60 96 C66 108 90 106 106 100 Z"/>
      <path d="M114 96 C138 70 168 78 160 96 C154 108 130 106 114 100 Z"/>
      <path d="M106 106 C88 116 74 132 84 138 C94 142 104 124 108 110 Z"/>
      <path d="M114 106 C132 116 146 132 136 138 C126 142 116 124 112 110 Z"/>
    </g>
    <path d="M76 90 C86 92 96 96 104 99 M144 90 C134 92 124 96 116 99" stroke="#fff" stroke-width="1.4" opacity=".7"/>
    <circle cx="110" cy="84" r="7" fill="#fff"/>
    <path d="M106 79 C102 72 98 70 95 70 M114 79 C118 72 122 70 125 70" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round"/>
    <ellipse cx="110" cy="112" rx="9" ry="22" fill="#fff"/>
    <path d="M101.5 104h17M101 112h18M102 120h16" stroke="#111" stroke-width="2.4"/>
    <!-- lettering -->
    <g font-family="Times New Roman, serif" font-size="15" letter-spacing="3" fill="#E9D9B0">
      <text><textPath href={`#${uid}-l`} startOffset="50%" text-anchor="middle">ROYAL</textPath></text>
      <text><textPath href={`#${uid}-r`} startOffset="50%" text-anchor="middle">BEES</textPath></text>
    </g>
    <text x="40" y="146" font-family="Times New Roman, serif" font-size="13" fill="#E9D9B0" text-anchor="middle">ESTP</text>
    <text x="180" y="146" font-family="Times New Roman, serif" font-size="13" fill="#E9D9B0" text-anchor="middle">1990</text>
    <text x="110" y="182" font-family="El Messiri, serif" font-weight="700" font-size="26" fill="#fff" text-anchor="middle">مملكة النحل</text>
  </svg>
  {withWordmark && <span class="logo-word">مملكة النحل</span>}
</span>

<style>
  .logo{display:inline-flex;align-items:center;gap:.6rem}
  .logo svg{flex:none;border-radius:50%}
  .logo-word{font-family:var(--font-display);font-weight:700;font-size:1.35rem;line-height:1}
</style>
