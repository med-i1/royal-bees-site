---
---
<div class="drawer-scrim" data-order-scrim hidden></div>
<div id="order-drawer" class="drawer" role="dialog" aria-modal="true" aria-labelledby="order-title" hidden>
  <div class="drawer-head">
    <h2 id="order-title">طلبك</h2>
    <button type="button" class="icon-btn" data-order-close aria-label="إغلاق الطلب">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
  <p class="drawer-empty" data-order-empty>لسه ما ضفتش حاجة. اختار عسلك من <a href="/honey/">الكتالوج</a>.</p>
  <ul class="drawer-list" data-order-list></ul>
  <p class="drawer-note" data-order-note role="status" aria-live="polite"></p>
  <div class="drawer-foot" data-order-foot>
    <div class="drawer-total"><span>الإجمالي</span><b data-order-total></b></div>
    <p class="drawer-hint">من غير التوصيل. مصاريف التوصيل بنأكدها معاك على واتساب.</p>
    <div class="drawer-fields">
      <label>الاسم <span>(اختياري)</span><input type="text" name="name" autocomplete="name" data-order-name /></label>
      <label>المنطقة <span>(اختياري)</span><input type="text" name="area" autocomplete="address-level2" data-order-area /></label>
    </div>
    <a class="btn btn-primary drawer-send" data-order-send target="_blank" rel="noopener">ابعت الطلب على واتساب</a>
    <button type="button" class="drawer-reset" data-order-reset>ابدأ طلب جديد</button>
  </div>
</div>

<style is:global>
  .drawer-scrim{position:fixed;inset:0;z-index:60;background:rgba(10,5,2,.6);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
  .drawer{position:fixed;z-index:61;inset-block:0;inset-inline-end:0;width:min(420px,100%);background:var(--bg-2);border-inline-start:1px solid var(--line);
    display:flex;flex-direction:column;padding:1.25rem 1.25rem 1.5rem;overflow-y:auto;box-shadow:-30px 0 80px -20px rgba(0,0,0,.7)}
  .drawer.is-open{animation:drawer-in .45s var(--ease-out)}
  @keyframes drawer-in{from{transform:translateX(-24px);opacity:0}to{transform:none;opacity:1}}
  .drawer-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem}
  .drawer-head h2{font-family:var(--font-display);font-size:1.6rem}
  .drawer-empty{color:var(--muted)} .drawer-empty a{color:var(--gold-2);text-decoration:underline}
  .drawer-list{list-style:none;display:grid;gap:.75rem}
  .order-line{display:grid;grid-template-columns:1fr auto;gap:.35rem .75rem;padding:.9rem 0;border-bottom:1px solid var(--line)}
  .order-line .nm{font-weight:600} .order-line .vr{color:var(--muted);font-size:.9rem}
  .order-line .pr{color:var(--gold-2);font-weight:600;align-self:center}
  .qty{display:inline-flex;align-items:center;gap:.25rem}
  .qty button{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:transparent;cursor:pointer}
  .qty output{min-width:2.2em;text-align:center}
  .order-line .del{background:none;border:0;color:var(--muted);text-decoration:underline;cursor:pointer;min-height:44px;justify-self:start}
  .drawer-note{color:var(--gold-2);font-size:.9rem;min-height:1.5em;margin:.5rem 0}
  .drawer-foot{margin-top:auto;display:grid;gap:.8rem}
  .drawer-total{display:flex;justify-content:space-between;font-size:1.15rem} .drawer-total b{color:var(--gold-2)}
  .drawer-hint{color:var(--muted);font-size:.85rem}
  .drawer-fields{display:grid;gap:.6rem}
  .drawer-fields label{display:grid;gap:.3rem;font-size:.9rem} .drawer-fields span{color:var(--muted)}
  .drawer-fields input{min-height:46px;border-radius:12px;border:1px solid var(--line);background:rgba(247,235,211,.04);color:var(--cream);padding:0 .9rem;font:inherit}
  .drawer-fields input:focus{outline:2px solid var(--gold-2);outline-offset:1px}
  .drawer-send[aria-disabled="true"]{opacity:.45;pointer-events:none}
  .drawer-reset{background:none;border:0;color:var(--muted);text-decoration:underline;cursor:pointer;min-height:44px}
  .icon-btn{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;border:1px solid var(--line);color:var(--cream);background:transparent;cursor:pointer}
  .icon-btn svg{width:20px;height:20px}
  @media (max-width:900px){
    .drawer{inset:auto 0 0 0;width:100%;max-height:88svh;border-radius:22px 22px 0 0;border-inline-start:0;border-top:1px solid var(--line)}
    @keyframes drawer-in{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}
  }
</style>
