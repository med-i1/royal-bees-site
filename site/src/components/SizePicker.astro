---
import type { Variant } from '../data/products';
interface Props { variants: Variant[] }
const { variants } = Astro.props;
---
<div class="sizes" role="radiogroup" aria-label="الحجم" data-size-picker>
  {variants.map((v, i) => (
    <button type="button" role="radio" class="size" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-variant={v.label} data-price={v.price}>{v.label}</button>
  ))}
</div>
<style>
  .sizes{display:flex;flex-wrap:wrap;gap:.6rem}
  .size{min-height:48px;padding:0 1.2rem;border-radius:14px;border:1px solid var(--line);background:transparent;color:var(--cream);cursor:pointer;font:inherit;transition:border-color .3s,background-color .3s}
  .size[aria-checked="true"]{border-color:var(--gold-2);background:rgba(247,196,90,.1);color:var(--gold-2);font-weight:600}
</style>
