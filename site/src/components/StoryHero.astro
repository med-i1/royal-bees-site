---
import { SITE } from '../config';
import { arDigits } from '../lib/format';
import { whatsappUrl } from '../lib/order';
const hello = whatsappUrl(`السلام عليكم، عايز أطلب من ${SITE.name}.`);
---
<section class="story" id="story" aria-labelledby="heroTitle">
  <div class="stage">
    <div class="stage-fx" id="stageFx">
      <div class="media" aria-hidden="true"><div class="zoom" id="heroZoom"><canvas id="heroCanvas"></canvas></div></div>
      <div class="shade" aria-hidden="true"></div>
      <div class="pollen" id="pollen" aria-hidden="true"></div>

      <div class="stage-inner">
        <div class="beats">
          <div class="beat beat-1">
            <p class="eyebrow" data-intro>منذ {arDigits(SITE.founded)} · {SITE.address}</p>
            <h1 id="heroTitle">
              <span class="h1-line"><span>عسلٌ كما</span></span>
              <span class="h1-line"><span class="accent">صنعته النحلة</span></span>
            </h1>
            <p class="lead" data-intro>سدر جبلي، مانوكا، وعسل مصري بجودة التصدير، وكل برطمان عليه ضمان ذهبي.</p>
            <div class="actions" data-intro>
              <a class="btn btn-primary" href="/honey/">تصفّح العسل
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></a>
              <a class="btn btn-ghost" href={hello} target="_blank" rel="noopener">اطلب على واتساب</a>
            </div>
            <ul class="trust" data-intro>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6Z"/><path d="m8.8 12.2 2.2 2.2 4.4-4.6"/></svg>ضمان التحليل المعملي</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>{SITE.delivery}</li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 19.8 7.5v9L12 21l-7.8-4.5v-9Z"/><path d="M12 8v4l2.5 1.5"/></svg>منذ {arDigits(SITE.founded)}</li>
            </ul>
          </div>

          <div class="beat beat-2">
            <p class="eyebrow">من الخلية لبرطمانك</p>
            <p class="beat-line">نقطة بنقطة،<br><span class="accent">من غير أي إضافات</span></p>
            <p class="lead">من المنحل لسفرتك، بخبرة من سنة {arDigits(SITE.founded)} في اختيار العسل.</p>
          </div>

          <div class="beat beat-3">
            <p class="eyebrow">الضمان الذهبي</p>
            <p class="beat-line">تحليل معملي…<br><span class="accent">أو فلوسك ترجعلك كاملة</span></p>
            <p class="lead">لو أي تحليل معتمد أثبت إن العسل مش طبيعي، بنرجعلك تمنه كله.</p>
            <div class="actions"><a class="btn btn-primary" href="/honey/">اختار عسلك</a></div>
          </div>
        </div>
      </div>

      <div class="rail" aria-hidden="true"><div class="rail-fill" id="railFill"></div><i class="on"></i><i></i><i></i></div>
      <div class="scroll-cue" id="scrollCue" aria-hidden="true">اسحب لتحت<span></span></div>
    </div>
  </div>
</section>

<script>import '../scripts/story';</script>

<style is:global>
  .story{position:relative}
  .stage{position:relative;height:100vh;height:100svh;overflow:hidden;isolation:isolate}
  .js-story .story{height:330vh}
  .js-story .stage{position:sticky;top:0}
  .stage-fx{position:absolute;inset:0;will-change:transform,opacity}
  .story .media{position:absolute;inset:0;z-index:-2;background:#140B05 url("/media/story-poster.jpg") left center/cover no-repeat}
  .story .media canvas{position:absolute;inset:0;width:100%;height:100%;opacity:0;transition:opacity .5s ease}
  .story .media canvas.ready{opacity:1}
  .story .zoom{position:absolute;inset:0;will-change:transform}
  .story .shade{position:absolute;inset:0;z-index:-1;pointer-events:none;background:
    linear-gradient(to left, rgba(20,11,5,.9) 0%, rgba(20,11,5,.55) 38%, rgba(20,11,5,0) 62%),
    linear-gradient(to bottom, rgba(20,11,5,.55) 0%, rgba(20,11,5,0) 18%),
    linear-gradient(to top, rgba(20,11,5,.6) 0%, rgba(20,11,5,0) 20%)}
  .pollen{position:absolute;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
  .pollen i{position:absolute;display:block;width:var(--s);height:var(--s);border-radius:50%;background:#FFD978;box-shadow:0 0 8px 2px rgba(255,200,80,.45);opacity:0;animation:float var(--d) linear var(--dl) infinite}
  @keyframes float{0%{transform:translate3d(0,0,0);opacity:0}15%{opacity:.7}85%{opacity:.45}100%{transform:translate3d(var(--x),-160px,0);opacity:0}}

  .stage-inner{position:relative;height:100%;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;padding:6.5rem clamp(2.75rem,6vw,5.5rem) 3.5rem}
  .beats{grid-column:1;display:grid;align-items:center}
  .beat{grid-area:1/1;max-width:36rem}
  .beat-2,.beat-3{display:none;max-width:40rem}
  .js-story .beat-2,.js-story .beat-3{display:block;opacity:0;visibility:hidden}
  .beat h1{font-family:var(--font-display);font-weight:700;font-size:clamp(2.5rem,5.8vw,5.2rem);line-height:1.18;margin:1.1rem 0 1.3rem}
  .h1-line{display:block;overflow:hidden;padding-block:.04em .12em}
  .h1-line>span{display:inline-block}
  .beat .actions{display:flex;flex-wrap:wrap;gap:.9rem;margin-top:2rem}
  .trust{display:flex;flex-wrap:wrap;gap:.7rem 1.6rem;margin-top:2.2rem;list-style:none;font-size:.92rem;color:var(--muted)}
  .trust li{display:flex;align-items:center;gap:.5rem}
  .trust svg{width:18px;height:18px;color:var(--gold-2);flex:none}
  .beat-line{font-family:var(--font-display);font-weight:700;font-size:clamp(2.2rem,4.1vw,3.7rem);line-height:1.22;margin:1rem 0 1.2rem;text-wrap:balance}

  .rail{position:absolute;inset-inline-start:clamp(1rem,2vw,1.8rem);top:50%;height:150px;width:2px;transform:translateY(-50%);background:rgba(247,235,211,.14);border-radius:2px;display:none}
  .js-story .rail{display:block}
  .rail-fill{position:absolute;inset:0;border-radius:inherit;background:linear-gradient(var(--gold-2),var(--gold));transform-origin:top;transform:scaleY(0)}
  .rail i{position:absolute;inset-inline-start:50%;width:9px;height:9px;margin-inline-start:-4.5px;border-radius:50%;background:var(--bg);border:1.5px solid rgba(247,196,90,.5);transition:background-color .3s,border-color .3s,transform .3s var(--ease-out)}
  .rail i:nth-of-type(1){top:-4px}.rail i:nth-of-type(2){top:calc(50% - 4.5px)}.rail i:nth-of-type(3){bottom:-4px}
  .rail i.on{background:var(--gold-2);border-color:var(--gold-2);transform:scale(1.15)}
  .scroll-cue{position:absolute;inset:auto 0 1.4rem 0;margin:auto;width:max-content;display:flex;flex-direction:column;align-items:center;gap:.4rem;font-size:.8rem;color:var(--muted)}
  .scroll-cue span{width:1px;height:38px;background:linear-gradient(var(--gold-2),transparent);transform-origin:top;animation:cue 2.2s var(--ease-out) infinite}
  @keyframes cue{0%{transform:scaleY(0)}50%{transform:scaleY(1)}100%{transform:scaleY(1);opacity:0}}

  .js-story .h1-line>span{transform:translateY(115%)}
  .js-story .story [data-intro]{opacity:0;transform:translateY(22px)}

  @media (max-width:900px){
    .stage-inner{grid-template-columns:1fr;align-items:end;padding:0 1.25rem 1.6rem;text-align:center}
    .story .media{inset:0 0 auto 0;height:64svh;background-image:url("/media/story-poster-mobile.jpg");background-position:center 30%}
    .story .media::after{content:"";position:absolute;inset:0;background:
      linear-gradient(to top, var(--bg) 0%, rgba(20,11,5,.88) 16%, rgba(20,11,5,.35) 34%, rgba(20,11,5,0) 52%),
      linear-gradient(to bottom, rgba(20,11,5,.65) 0%, rgba(20,11,5,0) 16%)}
    .story .shade{display:none}
    .beats{grid-column:auto;align-items:end}
    .beat{margin-inline:auto;align-self:end}
    .beat .eyebrow{justify-content:center}
    .beat h1{margin:.5rem 0 .7rem}
    .beat-line{font-size:clamp(1.9rem,8.4vw,2.5rem);margin:.6rem 0 .8rem}
    .beat .lead{margin-inline:auto;font-size:.98rem}
    .beat .actions{justify-content:center;flex-wrap:nowrap;gap:.6rem;margin-top:1.4rem}
    .beat .actions .btn{flex:1 1 0;min-width:0;padding:0 .9rem;font-size:.93rem}
    .trust{display:none}
    .rail{top:32svh;height:110px;inset-inline-start:.7rem}
    .scroll-cue{display:none}
  }
  @media (prefers-reduced-motion: reduce){ .pollen,.scroll-cue span{display:none} }
</style>
